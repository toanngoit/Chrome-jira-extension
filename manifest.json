{
  "manifest_version": 3,
  "name": "Jira Helper",
  "version": "1.0.2",
  "description": "Dim or hide finished child work items on Jira issues so you can focus on what is left, and jump to any issue by key. By Colton.",
  "action": {
    "default_title": "Jira Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://*.atlassian.net/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
