{
  "manifest_version": 3,
  "name": "Jira Helper",
  "version": "1.0.0",
  "description": "Dim child work items that are already Dev Done on Jira issues, so developers can focus on what is left. By Colton.",
  "action": {
    "default_title": "Jira Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://*.atlassian.net/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
